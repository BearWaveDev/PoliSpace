<%-- Menú lateral según el rol de la sesión. Marca como activa la página actual. --%>
<%
    // {archivo, texto, icono}
    String[][] _menu;
    if (rolId == Util.ROL_ADMIN) {
        _menu = new String[][]{
            {"Inicio.jsp", "Inicio", "hogar.png"},
            {"Usuarios.jsp", "Usuarios", "usuariob.png"},
            {"Escuelas.jsp", "Escuelas", "hogar.png"},
            {"Carreras.jsp", "Carreras", "cuaderno.png"},
            {"Profesores.jsp", "Profesores", "profesorb.png"},
            {"Grupos.jsp", "Grupos y alumnos", "usuariob.png"},
            {"Materias.jsp", "Materias", "materialb.png"},
            {"Ubicaciones.jsp", "Ubicaciones", "marketb.png"},
            {"Horarios.jsp", "Horarios", "horariob.png"},
            {"Asistencia.jsp", "Asistencia", "horariob.png"},
            {"Moderacion.jsp", "Moderación", "publicacionesb.png"},
            {"Perfil.jsp", "Mi cuenta", "usuariob.png"}};
    } else if (rolId == Util.ROL_PREFECTO) {
        _menu = new String[][]{
            {"Inicio.jsp", "Inicio", "hogar.png"},
            {"Asistencia.jsp", "Asistencia", "horariob.png"},
            {"Horarios.jsp", "Horarios", "horariob.png"},
            {"Profesores.jsp", "Profesores", "profesorb.png"},
            {"Grupos.jsp", "Grupos y alumnos", "usuariob.png"},
            {"Materias.jsp", "Materias", "materialb.png"},
            {"Ubicaciones.jsp", "Ubicaciones", "marketb.png"},
            {"Perfil.jsp", "Mi perfil", "usuariob.png"}};
    } else {
        _menu = new String[][]{
            {"Inicio.jsp", "Inicio", "hogar.png"},
            {"Perfil.jsp", "Mi perfil", "usuariob.png"},
            {"Horario.jsp", "Horario", "horariob.png"},
            {"Profesor.jsp", "Profesores", "profesorb.png"},
            {"Publicaciones.jsp", "Publicaciones", "publicacionesb.png"},
            {"MaterialEstudio.jsp", "Material de estudio", "materialb.png"},
            {"Marketplace.jsp", "Marketplace", "marketb.png"}};
    }
%>
    <aside class="sidebar">
        <div>
            <div class="logo">
                <img src="<%= ctx %>/Imagenes/Logo2.png" alt="Logo PoliSpace" width="180" height="100">
            </div>
            <nav class="sidebar-nav">
<% for (String[] _m : _menu) {
       boolean _activo = yo.endsWith("/" + carpetaRol + "/" + _m[0]); %>
                <a href="<%= ctx %>/<%= carpetaRol %>/<%= _m[0] %>" class="sidebar-nav-item<%= _activo ? " active" : "" %>">
                    <img src="<%= ctx %>/Imagenes/<%= _m[2] %>" alt="" class="nav-icon">
                    <span><%= _m[1] %></span>
                </a>
<% } %>
            </nav>
        </div>
        <div class="sidebar-footer">
            <a href="<%= ctx %>/LogoutServlet" class="sidebar-nav-item">
                <img src="<%= ctx %>/Imagenes/usuariob.png" alt="" class="nav-icon">
                <span>Cerrar sesión</span>
            </a>
        </div>
    </aside>
