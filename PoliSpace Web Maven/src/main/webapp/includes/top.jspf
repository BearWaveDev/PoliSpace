<%-- Requiere: base.jspf y la variable String titulo definida antes de incluirlo --%>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PoliSpace - <%= h(titulo) %></title>
    <link rel="stylesheet" href="<%= ctx %>/estilos/General.css"/>
    <link rel="stylesheet" href="<%= ctx %>/estilos/panel.css"/>
</head>
<body>
<div class="app-container">
<%@ include file="/includes/sidebar.jspf" %>
    <main class="main-content">
        <header class="topbar">
            <h2 class="title-large"><%= h(titulo) %></h2>
            <div class="topbar-right">
                <span class="badge badge-pink"><%= Util.nombreRol(rolId) %></span>
<%
    if (rolId == Util.ROL_ALUMNO) {
        long _sinLeer = 0;
        try {
            _sinLeer = Db.count("SELECT COUNT(*) FROM notificacion WHERE id_usuario_destino = ? AND leida = FALSE", uid);
        } catch (RuntimeException _ex) { /* el contador no es crítico */ }
%>
                <a href="<%= ctx %>/alumno/Notis.jsp" class="notif-link" title="Notificaciones">
                    <img src="<%= ctx %>/Imagenes/Notis.png" alt="Notificaciones" class="nav-icon">
                    <% if (_sinLeer > 0) { %><span class="notif-count"><%= _sinLeer > 99 ? "99+" : String.valueOf(_sinLeer) %></span><% } %>
                </a>
<% } %>
                <div class="avatar" title="<%= h((String) session.getAttribute("nombre")) %>"><%= Util.avatar(ctx, uid, (String) session.getAttribute("nombre")) %></div>
            </div>
        </header>
<%
    String _fTipo = (String) session.getAttribute("flashTipo");
    String _fMsg = (String) session.getAttribute("flashMsg");
    if (_fMsg != null) {
        session.removeAttribute("flashTipo");
        session.removeAttribute("flashMsg");
%>
        <div class="alerta alerta-<%= "ok".equals(_fTipo) ? "ok" : "error" %>"><%= h(_fMsg) %></div>
<% } %>
