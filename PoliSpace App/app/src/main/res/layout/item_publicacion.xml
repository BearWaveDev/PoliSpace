<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="@color/color_tarjeta"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/color_borde"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ENCABEZADO DEL USUARIO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- FOTO DEL USUARIO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardBackgroundColor="@color/color_fondo"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/color_primario"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/imgUsuarioPublicacion"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:contentDescription="Foto del usuario" />

            </com.google.android.material.card.MaterialCardView>

            <!-- DATOS DEL USUARIO -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNombreUsuarioPublicacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="María López"
                    android:textColor="@color/color_texto"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/tvFechaPublicacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Hace 2 horas"
                    android:textColor="@color/color_texto_secundario"
                    android:textSize="11sp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnOpcionesPublicacion"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_more"
                android:contentDescription="Opciones de publicación"
                app:tint="@color/color_texto_secundario" />

        </LinearLayout>

        <!-- TITULO DE LA PUBLICACION -->
        <TextView
            android:id="@+id/tvTituloPublicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Examen de programación - Segundo parcial"
            android:textColor="@color/color_texto"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- DESCRIPCION -->
        <TextView
            android:id="@+id/tvDescripcionPublicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Les comparto el examen que utilizamos para estudiar el segundo parcial. Incluye ejercicios de arreglos, ciclos y funciones. ¡Espero que les sirva!"
            android:textColor="@color/color_texto_secundario"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp" />

        <!-- ARCHIVO ADJUNTO -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardArchivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/color_fondo"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/color_borde"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <!-- ICONO DEL TIPO DE ARCHIVO -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="46dp"
                    android:layout_height="52dp"
                    app:cardBackgroundColor="@color/color_tarjeta"
                    app:cardCornerRadius="9dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/tvTipoArchivo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="PDF"
                        android:textColor="@color/color_primario"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </com.google.android.material.card.MaterialCardView>

                <!-- INFORMACION DEL ARCHIVO -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreArchivo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Examen_Programacion.pdf"
                        android:textColor="@color/color_texto"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:maxLines="2" />

                    <TextView
                        android:id="@+id/tvPesoArchivo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Documento PDF · 2.4 MB"
                        android:textColor="@color/color_texto_secundario"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- DESCARGAR / ABRIR -->
                <ImageButton
                    android:id="@+id/btnDescargarArchivo"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/stat_sys_download"
                    android:contentDescription="Descargar archivo"
                    app:tint="@color/color_primario" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ETIQUETAS ACADEMICAS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Clasificación académica"
            android:textColor="@color/color_texto_secundario"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupEtiquetas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            app:chipSpacingHorizontal="5dp"
            app:chipSpacingVertical="2dp"
            app:singleLine="false"
            app:singleSelection="false">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEscuela"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CECyT 9"
                android:textColor="@color/color_primario"
                android:textSize="11sp"
                android:checkable="false"
                app:chipBackgroundColor="@color/color_tarjeta"
                app:chipStrokeColor="@color/color_borde"
                app:chipStrokeWidth="1dp"
                app:ensureMinTouchTargetSize="false"
                app:chipMinHeight="30dp"
                app:closeIconVisible="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCarrera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Programación"
                android:textColor="@color/color_primario"
                android:textSize="11sp"
                android:checkable="false"
                app:chipBackgroundColor="@color/color_tarjeta"
                app:chipStrokeColor="@color/color_borde"
                app:chipStrokeWidth="1dp"
                app:ensureMinTouchTargetSize="false"
                app:chipMinHeight="30dp"
                app:closeIconVisible="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMateria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Programación"
                android:textColor="@color/color_primario"
                android:textSize="11sp"
                android:checkable="false"
                app:chipBackgroundColor="@color/color_tarjeta"
                app:chipStrokeColor="@color/color_borde"
                app:chipStrokeWidth="1dp"
                app:ensureMinTouchTargetSize="false"
                app:chipMinHeight="30dp"
                app:closeIconVisible="false" />

        </com.google.android.material.chip.ChipGroup>

        <!-- INTERACCIONES -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:background="@color/color_borde" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- ME GUSTA -->
            <LinearLayout
                android:id="@+id/btnMeGusta"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivMeGusta"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@android:drawable/btn_star_big_off"
                    android:contentDescription="Me gusta"
                    app:tint="@color/color_primario" />

                <TextView
                    android:id="@+id/tvMeGusta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Me gusta"
                    android:textColor="@color/color_texto_secundario"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- COMENTAR -->
            <LinearLayout
                android:id="@+id/btnComentar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@android:drawable/ic_menu_edit"
                    android:contentDescription="Comentar"
                    app:tint="@color/color_texto_secundario" />

                <TextView
                    android:id="@+id/tvCantidadComentarios"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Comentar"
                    android:textColor="@color/color_texto_secundario"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- GUARDAR -->
            <LinearLayout
                android:id="@+id/btnGuardarPublicacion"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivGuardarPublicacion"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@android:drawable/ic_menu_save"
                    android:contentDescription="Guardar publicación"
                    app:tint="@color/color_texto_secundario" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Guardar"
                    android:textColor="@color/color_texto_secundario"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
