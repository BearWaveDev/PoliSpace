<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_acerca"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/color_fondo"
    tools:context=".configuracionLateral.AcercaPoliSpaceFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/color_fondo">

        <!-- BARRA SUPERIOR DE ACERCA DE POLISPACE -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:background="@color/color_tarjeta"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <!-- BOTÓN ATRÁS -->
            <ImageButton
                android:id="@+id/btnAtrasAcerca"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_atras"
                android:contentDescription="Regresar" />

            <!-- TÍTULO -->
            <TextView
                android:id="@+id/tvTituloAcerca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/btnAtrasAcerca"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:text="Acerca de PoliSpace"
                android:textColor="@color/color_texto"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1" />

        </RelativeLayout>

        <!-- CONTENIDO -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- ENCABEZADO -->

                <!-- DESCRIPCIÓN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/color_encabezado"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="30dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="38dp">

                    <!-- LOGO -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="105dp"
                        android:layout_height="105dp"
                        app:cardBackgroundColor="@color/color_tarjeta"
                        app:cardCornerRadius="25dp"
                        app:cardElevation="4dp"
                        app:strokeColor="@color/color_acento"
                        app:strokeWidth="2dp">

                        <ImageView
                            android:id="@+id/imgLogoPoliSpace"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Logo de PoliSpace"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/logo" />

                    </com.google.android.material.card.MaterialCardView>

                    <!-- NOMBRE -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="PoliSpace"
                        android:textColor="@color/white"
                        android:textSize="27sp"
                        android:textStyle="bold" />

                    <!-- ESLOGAN -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:letterSpacing="0.08"
                        android:text="ESTUDIA · CONECTA · AVANZA"
                        android:textColor="#B7BDCE"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="Tu comunidad politécnica, en un solo espacio."
                        android:textColor="#D5D9E3"
                        android:textSize="14sp" />

                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="-20dp"
                    app:cardBackgroundColor="@color/color_tarjeta"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/color_borde"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="¿Qué es PoliSpace?"
                            android:textColor="@color/color_primario"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="PoliSpace es una plataforma creada para conectar a la comunidad politécnica en un espacio digital donde los estudiantes pueden compartir ideas, colaborar y acceder a recursos que faciliten su experiencia académica."
                            android:textColor="@color/color_texto"
                            android:textSize="14sp"
                            android:lineSpacingExtra="5dp"
                            android:justificationMode="inter_word" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- MISIÓN -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="18dp"
                    app:cardBackgroundColor="@color/color_tarjeta"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/color_borde"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nuestra misión"
                            android:textColor="@color/color_primario"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:text="Facilitar la comunicación y colaboración entre estudiantes mediante herramientas digitales que impulsen el aprendizaje, el intercambio de conocimientos y el sentido de comunidad."
                            android:textColor="@color/color_texto"
                            android:textSize="14sp"
                            android:lineSpacingExtra="5dp"
                            android:justificationMode="inter_word" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- VISIÓN -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/color_tarjeta"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/color_borde"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nuestra visión"
                            android:textColor="@color/color_primario"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:text="Construir un entorno digital donde la comunidad estudiantil pueda crecer, compartir experiencias y fortalecer sus conocimientos, convirtiendo a PoliSpace en un punto de encuentro académico."
                            android:textColor="@color/color_texto"
                            android:textSize="14sp"
                            android:lineSpacingExtra="5dp"
                            android:justificationMode="inter_word" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- FUNCIONALIDADES -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp"
                    android:text="¿Qué puedes hacer en PoliSpace?"
                    android:textColor="@color/color_texto"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- PUBLICACIONES -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="@color/color_tarjeta"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/color_borde"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="15dp">

                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:src="@android:drawable/ic_menu_edit"
                            android:tint="@color/color_primario"
                            android:contentDescription="Publicaciones" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Publicaciones"
                                android:textColor="@color/color_texto"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Comparte ideas, experiencias y contenido con otros estudiantes."
                                android:textColor="@color/color_texto_secundario"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- COMUNIDAD -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="@color/color_tarjeta"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/color_borde"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="15dp">

                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:src="@android:drawable/ic_menu_myplaces"
                            android:tint="@color/color_primario"
                            android:contentDescription="Comunidad" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Comunidad estudiantil"
                                android:textColor="@color/color_texto"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Conecta con otros alumnos y fortalece tu comunidad."
                                android:textColor="@color/color_texto_secundario"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- RECURSOS -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="@color/color_tarjeta"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/color_borde"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="15dp">

                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:src="@android:drawable/ic_menu_agenda"
                            android:tint="@color/color_primario"
                            android:contentDescription="Recursos académicos" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Recursos académicos"
                                android:textColor="@color/color_texto"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Accede y comparte materiales que apoyen tu aprendizaje."
                                android:textColor="@color/color_texto_secundario"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- INFORMACIÓN DE LA APP -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/color_tarjeta"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/color_borde"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Información de la aplicación"
                            android:textColor="@color/color_primario"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="16dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Aplicación"
                                android:textColor="@color/color_texto_secundario"
                                android:textSize="13sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PoliSpace"
                                android:textColor="@color/color_texto"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:background="@color/color_borde" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Versión"
                                android:textColor="@color/color_texto_secundario"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvVersionApp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1.0.0"
                                android:textColor="@color/color_texto"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:background="@color/color_borde" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:text="Desarrollado con dedicación para la comunidad politécnica."
                            android:textColor="@color/color_texto_secundario"
                            android:textSize="12sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- PIE DE PÁGINA -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:text="© 2026 PoliSpace. Todos los derechos reservados."
                    android:textColor="@color/color_texto_secundario"
                    android:textSize="11sp" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- MENU LATERAL DE CONFIGURACION -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view_acerca"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/color_tarjeta"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/navmenu_alumno"
        app:itemIconTint="@color/color_primario"
        app:itemTextColor="@color/color_texto" />

</androidx.drawerlayout.widget.DrawerLayout>
