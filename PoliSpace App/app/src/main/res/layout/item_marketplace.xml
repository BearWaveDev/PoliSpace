<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E5E5E5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgArticulo"
            android:layout_width="match_parent"
            android:layout_height="125dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"
            android:background="#EEEEEE"
            android:contentDescription="Imagen del artículo"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvCategoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Electrónica"
                android:textSize="11sp"
                android:textColor="#666666"/>

            <TextView
                android:id="@+id/tvTituloArticulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calculadora científica"
                android:textStyle="bold"
                android:textSize="15sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tvPrecioArticulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="$650 MXN"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#16834A"
                android:layout_marginTop="5dp"/>

            <TextView
                android:id="@+id/tvEstadoArticulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Disponible"
                android:textSize="12sp"
                android:textColor="#16834A"
                android:layout_marginTop="3dp"/>

            <TextView
                android:id="@+id/tvVendedor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vendedor: Alumno"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="5dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContactar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Contactar"
                android:textAllCaps="false"
                android:layout_marginTop="8dp"
                app:cornerRadius="10dp"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>