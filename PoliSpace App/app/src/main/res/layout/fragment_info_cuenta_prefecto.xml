<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/color_fondo"
    tools:context=".configuracionLateralPrefecto.InfoCuentaPrefectoFragment">

    <!-- Barra superior -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:background="@color/color_tarjeta"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnAtrasInfoCuentaPrefecto"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_atras"
            android:contentDescription="Regresar" />

        <TextView
            android:id="@+id/tvTituloInfoCuentaPrefecto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btnAtrasInfoCuentaPrefecto"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:text="Información de la cuenta"
            android:textColor="@color/color_texto"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1" />

    </RelativeLayout>

    <!-- Contenido -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mi cuenta"
                android:textColor="@color/color_texto"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Consulta la información que proporcionaste al registrarte en PoliSpace."
                android:textColor="@color/color_texto_secundario"
                android:textSize="14sp" />

            <!-- DATOS PERSONALES -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="@color/color_tarjeta"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Datos personales"
                        android:textColor="@color/color_primario"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <!-- Nombre completo -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Nombre completo"
                        android:textColor="@color/color_texto_secundario"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvInfoNombrePrefecto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Nombre y apellidos"
                        android:textColor="@color/color_texto"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="13dp"
                        android:background="@color/color_borde" />

                    <!-- Nombre de usuario -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:text="Nombre de usuario"
                        android:textColor="@color/color_texto_secundario"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvInfoUsuarioPrefecto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="usuario"
                        android:textColor="@color/color_texto"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="13dp"
                        android:background="@color/color_borde" />

                    <!-- Número de empleado -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:text="Número de empleado"
                        android:textColor="@color/color_texto_secundario"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvInfoNumeroEmpleadoPrefecto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Número de empleado"
                        android:textColor="@color/color_texto"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- INFORMACIÓN LABORAL -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="@color/color_tarjeta"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Información laboral"
                        android:textColor="@color/color_primario"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <!-- Escuela -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Escuela asignada"
                        android:textColor="@color/color_texto_secundario"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvInfoEscuelaPrefecto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Escuela asignada"
                        android:textColor="@color/color_texto"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="13dp"
                        android:background="@color/color_borde" />

                    <!-- Turno -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:text="Turno"
                        android:textColor="@color/color_texto_secundario"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvInfoTurnoPrefecto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Turno asignado"
                        android:textColor="@color/color_texto"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- DATOS DE ACCESO -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="@color/color_tarjeta"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Datos de acceso"
                        android:textColor="@color/color_primario"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <!-- Correo institucional -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Correo institucional"
                        android:textColor="@color/color_texto_secundario"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvInfoCorreoPrefecto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="correo@ipn.mx"
                        android:textColor="@color/color_texto"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="13dp"
                        android:background="@color/color_borde" />

                    <!-- Contraseña -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:text="Contraseña"
                        android:textColor="@color/color_texto_secundario"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="••••••••••••"
                        android:textColor="@color/color_texto"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Por seguridad, tu contraseña no se muestra."
                        android:textColor="@color/color_texto_secundario"
                        android:textSize="12sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- PIE DE PÁGINA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="PoliSpace · ESTUDIA · CONECTA · AVANZA"
                android:textColor="@color/color_texto_secundario"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
