<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_fondo"
    android:fitsSystemWindows="true"
    tools:context=".fragmentsAlumno.CrearPublicacionFragment">

    <!-- BARRA SUPERIOR -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:background="@color/color_tarjeta"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- BOTÓN ATRÁS -->
        <ImageButton
            android:id="@+id/btnAtrasCrearPublicacion"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_atras"
            android:contentDescription="Regresar"
            app:tint="@color/color_texto" />

        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btnAtrasCrearPublicacion"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:text="Crear publicación"
            android:textColor="@color/color_texto"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1" />

    </RelativeLayout>

    <!-- CONTENIDO -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/color_fondo"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="28dp">

            <!-- ENCABEZADO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Comparte tus conocimientos"
                android:textColor="@color/color_texto"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Comparte material y recursos con tu comunidad estudiantil."
                android:textColor="@color/color_texto_secundario"
                android:textSize="14sp" />

            <!-- TARJETA DEL FORMULARIO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="@color/color_tarjeta"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/color_borde"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- SECCIÓN INFORMACIÓN -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Información de la publicación"
                        android:textColor="@color/color_texto"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Completa los datos del material que deseas compartir."
                        android:textColor="@color/color_texto_secundario"
                        android:textSize="12sp" />

                    <!-- TÍTULO -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:hint="Título de la publicación *"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/color_primario"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="@color/color_primario">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTituloPublicacion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences"
                            android:textColor="@color/color_texto"
                            android:textColorHint="@color/color_texto_secundario"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- DESCRIPCIÓN -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Descripción *"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/color_primario"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="@color/color_primario">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDescripcionPublicacion"
                            android:layout_width="match_parent"
                            android:layout_height="130dp"
                            android:gravity="top|start"
                            android:inputType="textCapSentences|textMultiLine"
                            android:textColor="@color/color_texto"
                            android:textColorHint="@color/color_texto_secundario"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- ESCUELA -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Escuela *"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/color_primario"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="@color/color_primario">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEscuela"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:textColor="@color/color_texto"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- CARRERA -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Carrera *"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/color_primario"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="@color/color_primario">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCarrera"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:textColor="@color/color_texto"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- MATERIA -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Materia *"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/color_primario"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="@color/color_primario">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMateria"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:textColor="@color/color_texto"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- SEPARADOR -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="20dp"
                        android:background="@color/color_borde" />

                    <!-- SECCIÓN ARCHIVO -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Material de estudio"
                        android:textColor="@color/color_texto"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Puedes adjuntar un archivo PDF, Word u otro documento."
                        android:textColor="@color/color_texto_secundario"
                        android:textSize="12sp" />

                    <!-- BOTÓN ADJUNTAR -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSeleccionarArchivo"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="16dp"
                        android:text="Adjuntar archivo"
                        android:textAllCaps="false"
                        android:textColor="@color/color_texto"
                        android:textSize="14sp"
                        app:backgroundTint="@color/color_tarjeta"
                        app:cornerRadius="12dp"
                        app:icon="@android:drawable/ic_menu_upload"
                        app:iconTint="@color/color_primario"
                        app:strokeColor="@color/color_borde" />

                    <!-- ARCHIVO SELECCIONADO -->
                    <TextView
                        android:id="@+id/tvNombreArchivoSeleccionado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:padding="10dp"
                        android:text="No se ha seleccionado ningún archivo"
                        android:textColor="@color/color_texto_secundario"
                        android:textSize="13sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- BOTÓN PUBLICAR -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPublicar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:text="Publicar"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/color_primario"
                app:cornerRadius="14dp"
                app:elevation="3dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
