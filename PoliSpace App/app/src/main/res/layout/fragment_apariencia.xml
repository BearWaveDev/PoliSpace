<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_fondo"
    android:fitsSystemWindows="true"
    tools:context=".configuracionLateralAlumno.AparienciaFragment">

    <!-- BARRA SUPERIOR -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:background="@color/color_tarjeta"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- BOTON ATRAS -->
        <ImageButton
            android:id="@+id/btnAtrasApariencia"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_atras"
            android:contentDescription="Regresar" />

        <!-- TITULO -->
        <TextView
            android:id="@+id/tvTituloApariencia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btnAtrasApariencia"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:text="Apariencia"
            android:textColor="@color/color_texto"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1" />

    </RelativeLayout>

    <!-- CONTENIDO -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="@color/color_fondo">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- TITULO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apariencia"
                android:textColor="@color/color_texto"
                android:textSize="23sp"
                android:textStyle="bold" />

            <!-- DESCRIPCION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Personaliza la apariencia de PoliSpace."
                android:textColor="@color/color_texto_secundario"
                android:textSize="14sp" />

            <!-- SECCION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="12dp"
                android:text="TEMA"
                android:textColor="@color/color_texto_secundario"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- TARJETA MODO OSCURO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/color_tarjeta"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/color_borde"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="18dp">

                    <!-- ICONO -->
                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:padding="9dp"
                        android:src="@drawable/ic_apariencia"
                        android:tint="@color/color_primario"
                        android:contentDescription="Modo oscuro" />

                    <!-- INFORMACION -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Modo oscuro"
                            android:textColor="@color/color_texto"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Activa el tema oscuro en PoliSpace."
                            android:textColor="@color/color_texto_secundario"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- INTERRUPTOR -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchModoOscuro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        app:useMaterialThemeColors="false"
                        app:thumbTint="#FFFFFF"
                        app:trackTint="#A61956" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
