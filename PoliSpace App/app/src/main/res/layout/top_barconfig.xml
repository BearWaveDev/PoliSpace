<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:background="@color/color_nav"
    android:paddingStart="4dp"
    android:paddingEnd="15dp">

    <!-- TITULO POLISPACE -->
    <ImageView
        android:id="@+id/ivLogoToolbar"
        android:layout_width="150dp"
        android:layout_height="42dp"
        android:src="@drawable/logo_polispace"
        android:layout_marginTop="12dp"
        android:scaleType="fitCenter"
        android:contentDescription="Logo PoliSpace" />

    <!-- BOTON CONFIGURACION -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_menu_perfil"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="20dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Abrir menú de cuenta"
            android:padding="9dp"
            android:src="@drawable/ic_config"
            app:tint="@color/color_texto" />

    </LinearLayout>

</RelativeLayout>
