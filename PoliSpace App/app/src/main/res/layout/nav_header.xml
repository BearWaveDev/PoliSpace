<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/color_encabezado"
    android:gravity="center_vertical"
    android:minHeight="190dp"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="40dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- FOTO DE USUARIO CON DISEÑO REDONDO -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/img_nav_usuario"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="Foto del usuario"
        android:padding="2dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_gatocompu"
        app:shapeAppearanceOverlay="@style/ImagenCircular"
        app:strokeColor="#7A1D32"
        app:strokeWidth="2dp" />

    <!-- NOMBRE DEL ALUMNO -->
    <TextView
        android:id="@+id/txt_nav_nombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nombre del Alumno"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- CORREO -->
    <TextView
        android:id="@+id/txt_nav_correo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="usuario@ipn.mx"
        android:textColor="#A0A7B1"
        android:textSize="13sp" />

</LinearLayout>