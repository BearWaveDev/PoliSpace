<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:orientation="vertical"
    tools:context=".activities.registrarseAlumno">

    <!-- Encabezado superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="50dp"
        android:paddingEnd="28dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PoliSpace"
            android:textColor="@color/white"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="ESTUDIA · CONECTA · AVANZA"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Tu comunidad politécnica, en un solo espacio."
            android:textColor="@color/white"
            android:textSize="17sp" />

    </LinearLayout>

    <!-- Tarjeta del Formulario de Registro -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="24dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registrarse - Alumnos"
                    android:textColor="#172B4D"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Regístrate con tu correo institucional"
                    android:textColor="#8991A3"
                    android:textSize="10sp" />

                <!-- Número de Boleta (Identificador) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    app:boxBackgroundColor="#F1F3F7"
                    app:boxBackgroundMode="filled"
                    app:boxCornerRadiusBottomEnd="24dp"
                    app:boxCornerRadiusBottomStart="24dp"
                    app:boxCornerRadiusTopEnd="24dp"
                    app:boxCornerRadiusTopStart="24dp"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBoleta"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="  Número de boleta"
                        android:inputType="number"
                        android:maxLength="10"
                        android:paddingStart="12dp"
                        android:textColorHint="#6B778C"
                        android:textColor="@color/black"
                        android:textSize="11sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Correo Institucional -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    app:boxBackgroundColor="#F1F3F7"
                    app:boxBackgroundMode="filled"
                    app:boxCornerRadiusBottomEnd="24dp"
                    app:boxCornerRadiusBottomStart="24dp"
                    app:boxCornerRadiusTopEnd="24dp"
                    app:boxCornerRadiusTopStart="24dp"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCorreo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="  Correo institucional (@ipn.mx / @alumno.ipn.mx)"
                        android:inputType="textEmailAddress"
                        android:textColorHint="#6B778C"
                        android:paddingStart="12dp"
                        android:textColor="@color/black"
                        android:textSize="11sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Contraseña -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    app:boxBackgroundColor="#F1F3F7"
                    app:boxBackgroundMode="filled"
                    app:boxCornerRadiusBottomEnd="24dp"
                    app:boxCornerRadiusBottomStart="24dp"
                    app:boxCornerRadiusTopEnd="24dp"
                    app:boxCornerRadiusTopStart="24dp"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp"
                    app:endIconMode="password_toggle"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="  Contraseña"
                        android:inputType="textPassword"
                        android:textColorHint="#6B778C"
                        android:paddingStart="12dp"
                        android:textSize="11sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Selección de CECyT -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCecyt"
                    style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    app:boxBackgroundColor="#F1F3F7"
                    app:boxBackgroundMode="filled"
                    app:boxCornerRadiusBottomEnd="24dp"
                    app:boxCornerRadiusBottomStart="24dp"
                    app:boxCornerRadiusTopEnd="24dp"
                    app:boxCornerRadiusTopStart="24dp"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp"
                    app:hintEnabled="false">

                    <AutoCompleteTextView
                        android:id="@+id/actvCecyt"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="  Selecciona tu CECyT"
                        android:inputType="none"
                        android:paddingStart="12dp"
                        android:textColorHint="#6B778C"
                        android:textColor="@color/black"
                        android:textSize="11sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Selección de Carrera -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCarrera"
                    style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    app:boxBackgroundColor="#F1F3F7"
                    app:boxBackgroundMode="filled"
                    app:boxCornerRadiusBottomEnd="24dp"
                    app:boxCornerRadiusBottomStart="24dp"
                    app:boxCornerRadiusTopEnd="24dp"
                    app:boxCornerRadiusTopStart="24dp"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp"
                    app:hintEnabled="false">

                    <AutoCompleteTextView
                        android:id="@+id/actvCarrera"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="  Selecciona tu carrera"
                        android:inputType="none"
                        android:paddingStart="12dp"
                        android:textColor="@color/black"
                        android:textColorHint="#6B778C"
                        android:textSize="11sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Botón de Registro -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmRegister"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:text="Registrarse"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="#7A1D32"
                    app:cornerRadius="24dp"
                    app:elevation="0dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¿Ya tienes cuenta? "
                        android:textColor="#8991A3"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvLogin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Iniciar sesión"
                        android:textColor="#9D174D"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>