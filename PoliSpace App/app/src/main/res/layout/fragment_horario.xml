<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_fondo"
    android:fitsSystemWindows="true"
    tools:context=".fragmentsAlumno.HorarioFragment">

    <!-- BARRA SUPERIOR -->
    <include
        android:id="@+id/topBar"
        layout="@layout/top_bar" />

    <!-- CONTENIDO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@color/color_fondo">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="20dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mi horario"
                android:textColor="@color/color_texto"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Consulta tus clases de la semana."
                android:textColor="@color/color_texto_secundario"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- SELECTOR DE DÍAS -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupDias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:chipSpacingHorizontal="6dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLunes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lunes"
                    android:checkable="true"
                    android:checked="true"
                    android:textColor="@color/color_texto"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/color_tarjeta"
                    app:chipStrokeColor="@color/color_borde"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMartes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Martes"
                    android:checkable="true"
                    android:textColor="@color/color_texto"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/color_tarjeta"
                    app:chipStrokeColor="@color/color_borde"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMiercoles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Miércoles"
                    android:checkable="true"
                    android:textColor="@color/color_texto"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/color_tarjeta"
                    app:chipStrokeColor="@color/color_borde"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipJueves"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jueves"
                    android:checkable="true"
                    android:textColor="@color/color_texto"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/color_tarjeta"
                    app:chipStrokeColor="@color/color_borde"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipViernes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Viernes"
                    android:checkable="true"
                    android:textColor="@color/color_texto"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/color_tarjeta"
                    app:chipStrokeColor="@color/color_borde"
                    app:chipStrokeWidth="1dp" />

            </com.google.android.material.chip.ChipGroup>

        </HorizontalScrollView>

        <!-- DÍA SELECCIONADO -->
        <TextView
            android:id="@+id/tvDiaSeleccionado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="12dp"
            android:text="Clases del lunes"
            android:textColor="@color/color_texto"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- LISTA DE CLASES -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="85dp">

            <LinearLayout
                android:id="@+id/contenedorClases"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp">

                <!-- Las tarjetas se generan desde Java -->

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</LinearLayout>
